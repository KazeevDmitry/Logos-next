# Copy to .env.local and fill in. (Do not name it .env: docker compose reads that file.)
# Inside the full stack (../Logos-api/compose.yml) these are set for you.

# The NestJS API as this server reaches it. /api/v1 and /uploads are proxied there.
API_INTERNAL_URL=http://localhost:4000
# The API's public origin for the live chat connection (WebSocket).
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=
