# Copy to .env.local and fill in.

# Backend API base URL, including /api
NEXT_PUBLIC_API=http://localhost:1337/api
# Backend origin that serves uploaded files
NEXT_PUBLIC_UPLOADS_API=http://localhost:1337
# 32+ random characters, used to encrypt the session cookie
SECRET_COOKIE_PASSWORD=change-me-to-a-random-string-of-32-chars-or-more
